@page
@model OrbitWatch.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="ow-section-header">
    <h1 class="ow-title">@ViewData["Title"]</h1>
    <p class="ow-subtitle">ACCESS ORBITWATCH OPERATIONS</p>
</div>

<div class="ow-card" style="max-width: 500px; margin: 2rem auto;">
    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" style="color: red; margin-bottom: 1rem;" role="alert"></div>
        <div class="ow-form-group">
            <label asp-for="Input.Email" class="ow-label">Email</label>
            <input asp-for="Input.Email" class="ow-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            <span asp-validation-for="Input.Email" class="text-danger" style="color: red; font-size: 0.85rem; margin-top: 0.5rem; display: block;"></span>
        </div>
        <div class="ow-form-group">
            <label asp-for="Input.Password" class="ow-label">Password</label>
            <input asp-for="Input.Password" class="ow-input" autocomplete="current-password" aria-required="true" placeholder="password" type="password" />
            <span asp-validation-for="Input.Password" class="text-danger" style="color: red; font-size: 0.85rem; margin-top: 0.5rem; display: block;"></span>
        </div>
        <div class="ow-form-group">
            <button id="login-submit" type="submit" class="ow-btn ow-btn--primary" style="width: 100%;">Log in</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
