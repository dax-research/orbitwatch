@model IEnumerable<OrbitWatch.Models.Mission>

@{
    ViewData["Title"] = "Mission Register";
}

<section class="ow-page-header">
    <div>
        <div class="ow-eyebrow">FLIGHT CAMPAIGNS // OPERATIONS</div>
        <h1 class="ow-page-title">Mission Register</h1>
        <p class="ow-page-subtitle">Strategic satellite programs, exploration campaigns, and agency ownership records.</p>
    </div>
    <div>
        <a asp-action="Create" class="ow-btn">+ New Mission</a>
    </div>
</section>

@if (Model.Any())
{
    <div class="ow-list">
        @{ int index = 1; }
        @foreach (var mission in Model)
        {
            var statusClass = mission.Status.ToLowerInvariant() switch
            {
                "active" => "ow-status--active",
                "planned" => "ow-status--planned",
                "complete" or "completed" => "ow-status--completed",
                _ => ""
            };

            <div class="ow-list-row">
                <div class="ow-list-index">@index.ToString("D2")</div>

                <div class="ow-list-body">
                    <div class="ow-list-title">
                        <a asp-action="Details" asp-route-id="@mission.Id">@mission.Name</a>
                    </div>
                    <div class="ow-list-meta">
                        AGENCY: @mission.Agency &nbsp;•&nbsp;
                        @mission.Satellites.Count SATELLITE@(mission.Satellites.Count == 1 ? "" : "S") DEPLOYED
                    </div>
                </div>

                <div class="ow-list-aside">
                    <div class="ow-list-detail">@mission.LaunchDate.ToString("dd MMMM yyyy")</div>
                    <div class="ow-list-meta">
                        @(mission.EndDate.HasValue ? $"CONCLUDED: {mission.EndDate.Value:dd MMM yyyy}" : "INDEFINITE MISSION LIFESPAN")
                    </div>
                </div>

                <div class="ow-list-status">
                    <span class="ow-status @statusClass">@mission.Status</span>
                </div>

                <div class="ow-list-actions">
                    <a asp-action="Details" asp-route-id="@mission.Id" class="ow-action">Details</a>
                    <a asp-action="Edit" asp-route-id="@mission.Id" class="ow-action">Edit</a>
                    <a asp-action="Delete" asp-route-id="@mission.Id" class="ow-action ow-action--danger">Delete</a>
                </div>
            </div>
            index++;
        }
    </div>
}
else
{
    <div class="ow-empty">
        <div class="ow-eyebrow" style="justify-content: center;">NO CAMPAIGNS REGISTERED</div>
        <h2 style="font-size: 2.2rem; margin: 1rem 0;">Mission register is currently clear.</h2>
        <p style="color: #666; margin-bottom: 2rem;">Initiate an operational baseline to begin tracking space assets.</p>
        <a asp-action="Create" class="ow-btn">+ Register First Mission</a>
    </div>
}
