@model OrbitWatch.Models.Mission

@{
    ViewData["Title"] = $"{Model.Name} — Mission Details";
    var statusClass = Model.Status.ToLowerInvariant() switch
    {
        "active" => "ow-status--active",
        "planned" => "ow-status--planned",
        "complete" or "completed" => "ow-status--completed",
        _ => ""
    };
}

<section class="ow-page-header">
    <div>
        <div class="ow-eyebrow">MISSION SPECIFICATION // PROGRAM RECORD</div>
        <h1 class="ow-page-title">@Model.Name</h1>
        <p class="ow-page-subtitle">
            AGENCY: @Model.Agency &nbsp;•&nbsp;
            <span class="ow-status @statusClass">@Model.Status</span>
        </p>
    </div>
    <div style="display: flex; gap: 1rem;">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="ow-btn">Edit Mission</a>
        <a asp-action="Index" class="ow-btn ow-btn--secondary">← Return to Register</a>
    </div>
</section>

<div class="ow-details-grid">
    <div class="ow-panel">
        <div class="ow-eyebrow">OPERATIONAL TIMELINE &amp; COMMAND</div>
        <dl class="ow-dl">
            <dt>Operating Agency</dt>
            <dd>@Model.Agency</dd>
            <dt>Launch Date</dt>
            <dd>@Model.LaunchDate.ToString("dd MMMM yyyy")</dd>
            <dt>Conclusion Date</dt>
            <dd>@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("dd MMMM yyyy") : "Active / Ongoing Campaign")</dd>
            <dt>Program Status</dt>
            <dd><span class="ow-status @statusClass">@Model.Status</span></dd>
        </dl>
    </div>

    <div class="ow-panel">
        <div class="ow-eyebrow">MISSION OBJECTIVES &amp; BRIEF</div>
        @if (string.IsNullOrWhiteSpace(Model.Description))
        {
            <p style="color: #777; font-style: italic;">No operational description recorded for this campaign.</p>
        }
        else
        {
            <p style="font-size: 1.05rem; line-height: 1.7; color: #222; white-space: pre-line;">@Model.Description</p>
        }
    </div>

    <div class="ow-panel ow-panel--full">
        <div class="ow-eyebrow" style="margin-bottom: 1.5rem;">DEPLOYED CELESTIAL ASSETS (@Model.Satellites.Count TOTAL)</div>

        @if (Model.Satellites.Any())
        {
            <div class="ow-card-grid">
                @foreach (var sat in Model.Satellites.OrderBy(s => s.Name))
                {
                    <div class="ow-card-grid-item" style="min-height: 180px;">
                        <div>
                            <div class="ow-tag" style="margin-bottom: 0.5rem;">NORAD @sat.NoradId // @sat.OrbitType</div>
                            <h3 style="font-size: 1.6rem; margin-bottom: 0.5rem;">
                                <a asp-controller="Satellites" asp-action="Details" asp-route-id="@sat.Id">@sat.Name</a>
                            </h3>
                            <div style="font-size: 0.85rem; color: #666;">Operator: @sat.Operator (@sat.Country)</div>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem;">
                            <span class="ow-status">@sat.Status</span>
                            <a asp-controller="Satellites" asp-action="Details" asp-route-id="@sat.Id" class="ow-action">View Telemetry →</a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="padding: 2rem 0; color: #777;">
                No orbital assets have been assigned to this mission campaign yet.
                <div style="margin-top: 1rem;">
                    <a asp-controller="Satellites" asp-action="Create" class="ow-action">+ Deploy satellite to this mission</a>
                </div>
            </div>
        }
    </div>
</div>
