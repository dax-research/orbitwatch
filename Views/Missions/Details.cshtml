@model OrbitWatch.Models.Mission

@{
    ViewData["Title"] = "Mission Details";
    var statusClass = Model.Status.ToLowerInvariant() switch
    {
        "active" => "mission-status--active",
        "planned" => "mission-status--planned",
        "complete" or "completed" => "mission-status--completed",
        _ => "mission-status--default"
    };
}

<section class="mission-page">
    <div class="d-flex flex-column flex-md-row align-items-md-start justify-content-between gap-3 mb-4">
        <div>
            <div class="mission-eyebrow mb-2">Mission register / Details</div>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <h1 class="mission-title display-6 mb-0">@Model.Name</h1>
                <span class="mission-status @statusClass">@Model.Status</span>
            </div>
            <p class="mission-subtitle mt-2 mb-0">@Model.Agency operational record</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="mission-button text-decoration-none">Edit mission</a>
            <a asp-action="Index" class="mission-button mission-button--secondary text-decoration-none">Back</a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="mission-panel p-3 p-md-4 h-100">
                <div class="mission-eyebrow mb-3">Mission brief</div>
                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="mission-subtitle mb-0">No mission description has been recorded.</p>
                }
                else
                {
                    <p class="mb-0" style="white-space: pre-line;">@Model.Description</p>
                }
            </div>
        </div>
        <div class="col-lg-4">
            <div class="mission-panel p-3 p-md-4 h-100">
                <div class="mission-eyebrow mb-3">Timeline</div>
                <dl class="mb-0">
                    <dt class="mission-detail-label mb-1">Launch date</dt>
                    <dd class="mission-detail-value mb-3">@Model.LaunchDate.ToString("dd MMMM yyyy")</dd>
                    <dt class="mission-detail-label mb-1">End date</dt>
                    <dd class="mission-detail-value mb-0">@(Model.EndDate?.ToString("dd MMMM yyyy") ?? "Not recorded")</dd>
                </dl>
            </div>
        </div>
        <div class="col-12">
            <div class="mission-panel p-3 p-md-4">
                <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        <div class="mission-eyebrow mb-1">Assigned assets</div>
                        <h2 class="h5 text-white mb-0">Associated satellites</h2>
                    </div>
                    <span class="mission-status mission-status--default">@Model.Satellites.Count total</span>
                </div>
                @if (Model.Satellites.Any())
                {
                    <div class="row g-3">
                        @foreach (var satellite in Model.Satellites.OrderBy(satellite => satellite.Name))
                        {
                            <div class="col-md-6 col-xl-4">
                                <div class="mission-satellite-card">
                                    <div class="text-white fw-semibold">@satellite.Name</div>
                                    <div class="mission-meta mt-1">NORAD @satellite.NoradId · @satellite.OrbitType</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="mission-subtitle mb-0">No satellites are assigned to this mission yet.</p>
                }
            </div>
        </div>
    </div>
</section>
