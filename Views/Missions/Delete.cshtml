@model OrbitWatch.Models.Mission

@{
    ViewData["Title"] = "Delete Mission";
}

<section class="mission-page">
    <div class="mb-4">
        <div class="mission-eyebrow mb-2">Mission register / Confirmation required</div>
        <h1 class="mission-title display-6 mb-2">Delete mission?</h1>
        <p class="mission-subtitle mb-0">Review this record before permanently removing it from OrbitWatch.</p>
    </div>

    <div class="mission-panel p-3 p-md-4">
        <div class="mission-warning p-3 mb-4">
            <strong>Destructive action.</strong>
            @if (Model.Satellites.Any())
            {
                <span> This mission currently has @Model.Satellites.Count associated satellite@(Model.Satellites.Count == 1 ? "" : "s"). The database relationship is configured to remove those satellite records when the mission is deleted.</span>
            }
            else
            {
                <span> This action cannot be undone.</span>
            }
        </div>

        <dl class="row mb-4">
            <dt class="col-sm-3 mission-detail-label">Mission</dt>
            <dd class="col-sm-9 mission-detail-value">@Model.Name</dd>
            <dt class="col-sm-3 mission-detail-label">Agency</dt>
            <dd class="col-sm-9 mission-detail-value">@Model.Agency</dd>
            <dt class="col-sm-3 mission-detail-label">Launch date</dt>
            <dd class="col-sm-9 mission-detail-value">@Model.LaunchDate.ToString("dd MMMM yyyy")</dd>
            <dt class="col-sm-3 mission-detail-label">Status</dt>
            <dd class="col-sm-9 mission-detail-value">@Model.Status</dd>
        </dl>

        <form asp-action="Delete" method="post" class="d-flex flex-wrap gap-2">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="mission-button mission-button--danger">Yes, delete mission</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="mission-button mission-button--secondary text-decoration-none">Cancel</a>
        </form>
    </div>
</section>
