@model OrbitWatch.Models.Mission

@{
    ViewData["Title"] = $"Decommission {Model.Name} — Mission Removal";
}

<section class="ow-page-header">
    <div>
        <div class="ow-eyebrow">DECOMMISSION PROTOCOL // CONFIRMATION REQUIRED</div>
        <h1 class="ow-page-title">Delete Mission?</h1>
        <p class="ow-page-subtitle">Confirm permanent decommissioning of mission record <strong>@Model.Name</strong>.</p>
    </div>
</section>

<div class="ow-form-wrap">
    <div class="ow-warning-box">
        <strong>CRITICAL DESTRUCTIVE ACTION:</strong>
        @if (Model.Satellites.Any())
        {
            <span>
                This mission currently has <strong>@Model.Satellites.Count assigned satellite@(Model.Satellites.Count == 1 ? "" : "s")</strong>.
                Deleting this mission record will cascade and permanently remove all linked satellite assets and their telemetry archives.
            </span>
        }
        else
        {
            <span>
                This action is permanent and will remove the mission directive from the flight register. This operation cannot be reversed.
            </span>
        }
    </div>

    <dl class="ow-dl" style="margin-bottom: 2.5rem;">
        <dt>Mission</dt>
        <dd>@Model.Name</dd>
        <dt>Agency</dt>
        <dd>@Model.Agency</dd>
        <dt>Launch Date</dt>
        <dd>@Model.LaunchDate.ToString("dd MMMM yyyy")</dd>
        <dt>Status</dt>
        <dd>@Model.Status</dd>
        <dt>Assets Linked</dt>
        <dd>@Model.Satellites.Count satellites</dd>
    </dl>

    <form asp-action="Delete" method="post" class="ow-form-actions">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="ow-btn ow-btn--danger">Execute Deletion</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="ow-btn ow-btn--secondary">Abort &amp; Return</a>
    </form>
</div>
