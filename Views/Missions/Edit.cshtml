@model OrbitWatch.Models.Mission

@{
    ViewData["Title"] = $"Edit {Model.Name} — Mission Control";
}

<section class="ow-page-header">
    <div>
        <div class="ow-eyebrow">MISSION CONTROL // UPDATE PARAMETERS</div>
        <h1 class="ow-page-title">Edit Mission</h1>
        <p class="ow-page-subtitle">Modifying operating manifest and mission directives for <strong>@Model.Name</strong>.</p>
    </div>
</section>

<div class="ow-form-wrap">
    <form asp-action="Edit" method="post" novalidate>
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="text-danger mb-4"></div>

        <div class="ow-form-grid">
            <div class="ow-field ow-field--wide">
                <label asp-for="Name" class="ow-label">MISSION DESIGNATION / NAME</label>
                <input asp-for="Name" class="ow-input" />
                <span asp-validation-for="Name" class="ow-field-error"></span>
            </div>

            <div class="ow-field">
                <label asp-for="Agency" class="ow-label">OPERATING AGENCY</label>
                <input asp-for="Agency" class="ow-input" />
                <span asp-validation-for="Agency" class="ow-field-error"></span>
            </div>

            <div class="ow-field">
                <label asp-for="Status" class="ow-label">OPERATIONAL STATUS</label>
                <select asp-for="Status" class="ow-select">
                    <option>Planned</option>
                    <option>Active</option>
                    <option>Completed</option>
                    <option>On Hold</option>
                </select>
                <span asp-validation-for="Status" class="ow-field-error"></span>
            </div>

            <div class="ow-field">
                <label asp-for="LaunchDate" class="ow-label">LAUNCH DATE (UTC)</label>
                <input asp-for="LaunchDate" class="ow-input" type="date" />
                <span asp-validation-for="LaunchDate" class="ow-field-error"></span>
            </div>

            <div class="ow-field">
                <label asp-for="EndDate" class="ow-label">CONCLUSION / END DATE (OPTIONAL)</label>
                <input asp-for="EndDate" class="ow-input" type="date" />
                <span asp-validation-for="EndDate" class="ow-field-error"></span>
            </div>

            <div class="ow-field ow-field--wide">
                <label asp-for="Description" class="ow-label">MISSION OBJECTIVES &amp; SCIENTIFIC SCOPE</label>
                <textarea asp-for="Description" class="ow-textarea"></textarea>
                <span asp-validation-for="Description" class="ow-field-error"></span>
            </div>
        </div>

        <div class="ow-form-actions">
            <button type="submit" class="ow-btn">Save Changes →</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="ow-btn ow-btn--secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
