@model OrbitWatch.Models.Mission

@{
    ViewData["Title"] = "Edit Mission";
}

<section class="mission-page">
    <div class="mb-4">
        <div class="mission-eyebrow mb-2">Mission register / Update record</div>
        <h1 class="mission-title display-6 mb-2">Edit mission</h1>
        <p class="mission-subtitle mb-0">Update the operating record for <span class="text-white">@Model.Name</span>.</p>
    </div>

    <div class="mission-panel p-3 p-md-4">
        <form asp-action="Edit" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-4">
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label mission-form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Agency" class="form-label mission-form-label"></label>
                    <input asp-for="Agency" class="form-control" />
                    <span asp-validation-for="Agency"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LaunchDate" class="form-label mission-form-label"></label>
                    <input asp-for="LaunchDate" class="form-control" />
                    <span asp-validation-for="LaunchDate"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EndDate" class="form-label mission-form-label"></label>
                    <input asp-for="EndDate" class="form-control" />
                    <span asp-validation-for="EndDate"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Status" class="form-label mission-form-label"></label>
                    <select asp-for="Status" class="form-select">
                        <option>Planned</option>
                        <option>Active</option>
                        <option>Completed</option>
                        <option>On Hold</option>
                    </select>
                    <span asp-validation-for="Status"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label mission-form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description"></span>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-4 pt-2">
                <button type="submit" class="mission-button">Save changes</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="mission-button mission-button--secondary text-decoration-none">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
