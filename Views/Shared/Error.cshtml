@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="ow-page">
    <header class="ow-page-header">
        <div class="ow-page-eyebrow">System / Error</div>
        <h1 class="ow-page-title">Something Went Wrong</h1>
        <p class="ow-page-desc">An error occurred while processing your request.</p>
    </header>

    <div class="ow-panel">
        <div class="ow-panel-body">
            @if (Model.ShowRequestId)
            {
                <dl class="ow-dl ow-dl--stacked">
                    <dt>Request ID</dt>
                    <dd><code class="ow-code">@Model.RequestId</code></dd>
                </dl>
            }

            <p class="ow-page-desc" style="margin-top: 1.5rem;">
                If you are running locally, enable the Development environment for more detailed error information.
            </p>

            <div class="ow-page-actions">
                <a asp-controller="Home" asp-action="Index" class="ow-btn ow-btn--ghost ow-btn-arrow">Return Home</a>
            </div>
        </div>
    </div>
</div>
