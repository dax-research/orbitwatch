@model IEnumerable<OrbitWatch.Models.GroundStation>

@{
    ViewData["Title"] = "Ground Stations";
}

<section class="ow-page-header">
    <div>
        <div class="ow-eyebrow">TERRESTRIAL DOWNLINK // SENSOR RELAY NETWORK</div>
        <h1 class="ow-page-title">Ground Stations</h1>
        <p class="ow-page-subtitle">Global network of parabolic dish tracking arrays, deep space telemetry downlinks, and optical transceiver facilities.</p>
    </div>
    <div>
        <a asp-action="Create" class="ow-btn">+ Register Ground Station</a>
    </div>
</section>

@if (Model.Any())
{
    <div class="ow-card-grid">
        @foreach (var station in Model)
        {
            <div class="ow-card-grid-item">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
                        <span class="ow-tag">@station.Country</span>
                        <span class="ow-status ow-status--active">@(station.Status ?? "OPERATIONAL")</span>
                    </div>

                    <h3 style="font-size: 1.85rem; margin-bottom: 0.75rem;">
                        <a asp-action="Details" asp-route-id="@station.Id">@station.Name</a>
                    </h3>

                    <div style="font-family: var(--font-mono); font-size: 0.8rem; color: #555; margin-bottom: 0.5rem;">
                        COORD: @station.Location
                    </div>

                    <div style="font-size: 0.9rem; color: #777;">
                        Operator: <strong>@(station.Operator ?? "National Space Agency")</strong>
                    </div>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; border-top: 1px solid var(--ow-border); padding-top: 1.25rem;">
                    <a asp-action="Details" asp-route-id="@station.Id" class="ow-action">Station Dossier →</a>
                    <div style="display: flex; gap: 0.75rem;">
                        <a asp-action="Edit" asp-route-id="@station.Id" class="ow-action">Edit</a>
                        <a asp-action="Delete" asp-route-id="@station.Id" class="ow-action ow-action--danger">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="ow-empty">
        <div class="ow-eyebrow" style="justify-content: center;">NO GROUND RELAY REGISTERED</div>
        <h2 style="font-size: 2.2rem; margin: 1rem 0;">Ground network is uninitialized.</h2>
        <p style="color: #666; margin-bottom: 2rem;">Register terrestrial telemetry downlinks to acquire satellite passes.</p>
        <a asp-action="Create" class="ow-btn">+ Register First Ground Station</a>
    </div>
}
