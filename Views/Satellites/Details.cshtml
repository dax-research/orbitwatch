@model OrbitWatch.Models.Satellite

@{
    ViewData["Title"] = "Satellite Details";
    var statusClass = Model.Status.ToLowerInvariant() switch
    {
        "active"         => "ow-status--active",
        "inactive"       => "ow-status--inactive",
        "decommissioned" => "ow-status--decommissioned",
        _                => "ow-status--default"
    };
}

<section class="ow-page">
    <div class="ow-page-header">
        <div>
            <div class="ow-eyebrow">Satellite Network / Asset Record</div>
            <h1 class="ow-page-title">@Model.Name</h1>
            <p class="ow-page-subtitle">
                NORAD&nbsp;@Model.NoradId
                &nbsp;&middot;&nbsp;
                @Model.OrbitType
                &nbsp;&middot;&nbsp;
                <span class="ow-status @statusClass">@Model.Status</span>
            </p>
        </div>
        <div class="ow-action-group">
            <a asp-action="Edit"  asp-route-id="@Model.Id" class="ow-btn">Edit</a>
            <a asp-action="Index"                          class="ow-btn ow-btn--secondary">Back</a>
        </div>
    </div>

    <div class="ow-details-grid">
        <!-- Specs panel -->
        <div class="ow-panel">
            <div class="ow-eyebrow">Asset Specification</div>
            <dl class="ow-dl">
                <dt>Operator</dt>
                <dd>@Model.Operator</dd>
                <dt>Country</dt>
                <dd>@Model.Country</dd>
                <dt>Orbit Type</dt>
                <dd>@Model.OrbitType</dd>
                <dt>Launch Date</dt>
                <dd>@Model.LaunchDate.ToString("dd MMMM yyyy")</dd>
                <dt>Mission</dt>
                <dd>
                    @if (Model.Mission != null)
                    {
                        <a asp-controller="Missions" asp-action="Details" asp-route-id="@Model.Mission.Id" class="ow-link">@Model.Mission.Name</a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </dd>
            </dl>
        </div>

        <!-- Trajectory records -->
        <div class="ow-panel">
            <div class="ow-eyebrow">Trajectory Records</div>
            @if (Model.TrajectoryRecords.Any())
            {
                <table class="ow-table">
                    <thead>
                        <tr>
                            <th>Recorded At</th>
                            <th>Latitude</th>
                            <th>Longitude</th>
                            <th>Altitude (km)</th>
                            <th>Velocity (km/s)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tr in Model.TrajectoryRecords.OrderByDescending(t => t.RecordedAt).Take(5))
                        {
                            <tr>
                                <td>@tr.RecordedAt.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@tr.Latitude.ToString("F4")</td>
                                <td>@tr.Longitude.ToString("F4")</td>
                                <td>@tr.Altitude.ToString("F1")</td>
                                <td>@tr.Velocity.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="ow-panel-footer">
                    <a asp-controller="TrajectoryRecords" asp-action="Index" class="ow-action">View all trajectory records →</a>
                </div>
            }
            else
            {
                <p class="ow-empty-inline">No trajectory records logged.</p>
            }
        </div>

        <!-- Incidents -->
        <div class="ow-panel">
            <div class="ow-eyebrow">Incident Log</div>
            @if (Model.Incidents.Any())
            {
                <table class="ow-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Severity</th>
                            <th>Occurred</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var incident in Model.Incidents.OrderByDescending(i => i.OccurredAt).Take(5))
                        {
                            <tr>
                                <td>@incident.Type</td>
                                <td>@incident.Severity</td>
                                <td>@incident.OccurredAt.ToString("dd MMM yyyy")</td>
                                <td>@incident.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="ow-empty-inline">No incidents recorded.</p>
            }
        </div>

        <!-- Observations -->
        <div class="ow-panel">
            <div class="ow-eyebrow">Observations</div>
            @if (Model.SatelliteObservations.Any())
            {
                <table class="ow-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Observed</th>
                            <th>Signal (dBm)</th>
                            <th>Temp (°C)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var obs in Model.SatelliteObservations.OrderByDescending(o => o.ObservedAt).Take(5))
                        {
                            <tr>
                                <td>@obs.ObservationType</td>
                                <td>@obs.ObservedAt.ToString("dd MMM yyyy")</td>
                                <td>@(obs.SignalStrength?.ToString("F1") ?? "—")</td>
                                <td>@(obs.Temperature?.ToString("F1") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="ow-empty-inline">No observations recorded.</p>
            }
        </div>
    </div>
</section>
