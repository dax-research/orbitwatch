@model OrbitWatch.ViewModels.SatelliteDetailsViewModel

@{
    ViewData["Title"] = $"{Model.Satellite.Name} — Satellite Dossier";
    var statusClass = Model.Satellite.Status.ToLowerInvariant() switch
    {
        "active" => "ow-status--active",
        "decommissioned" => "ow-status--completed",
        _ => ""
    };
}

<section class="ow-page-header">
    <div>
        <div class="ow-eyebrow">CELESTIAL ASSET DOSSIER // NORAD #@Model.Satellite.NoradId</div>
        <h1 class="ow-page-title">@Model.Satellite.Name</h1>
        <p class="ow-page-subtitle">
            ORBIT: @Model.Satellite.OrbitType &nbsp;•&nbsp;
            OPERATOR: @Model.Satellite.Operator (@Model.Satellite.Country) &nbsp;•&nbsp;
            <span class="ow-status @statusClass">@Model.Satellite.Status</span>
        </p>
    </div>
    <div style="display: flex; gap: 1rem;">
        <a asp-action="Edit" asp-route-id="@Model.Satellite.Id" class="ow-btn">Edit Asset</a>
        <a asp-action="Index" class="ow-btn ow-btn--secondary">← Return to Catalogue</a>
    </div>
</section>

<div class="ow-details-grid">
    <div class="ow-panel">
        <div class="ow-eyebrow">ASSET SPECIFICATION</div>
        <dl class="ow-dl">
            <dt>Spacecraft Name</dt>
            <dd>@Model.Satellite.Name</dd>
            <dt>NORAD Catalog ID</dt>
            <dd style="font-family: var(--font-mono); font-size: 1.1rem;">#@Model.Satellite.NoradId</dd>
            <dt>Sovereign Country</dt>
            <dd>@Model.Satellite.Country</dd>
            <dt>Operating Entity</dt>
            <dd>@Model.Satellite.Operator</dd>
            <dt>Orbit Class</dt>
            <dd><span class="ow-status">@Model.Satellite.OrbitType</span></dd>
            <dt>Deployment Date</dt>
            <dd>@Model.Satellite.LaunchDate.ToString("dd MMMM yyyy")</dd>
            <dt>Assigned Mission</dt>
            <dd>
                @if (Model.Satellite.Mission != null)
                {
                    <a asp-controller="Missions" asp-action="Details" asp-route-id="@Model.Satellite.Mission.Id" class="ow-action">
                        @Model.Satellite.Mission.Name
                    </a>
                }
                else
                {
                    <span>Independent Asset</span>
                }
            </dd>
        </dl>
    </div>

    <div class="ow-panel">
        <div class="ow-eyebrow">RECENT TELEMETRY VECTORS</div>
        @if (Model.Satellite.TrajectoryRecords.Any())
        {
            <div class="ow-table-wrap">
                <table class="ow-table">
                    <thead>
                        <tr>
                            <th>Recorded (UTC)</th>
                            <th>Coords</th>
                            <th>Alt (km)</th>
                            <th>Vel (km/s)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tr in Model.Satellite.TrajectoryRecords.OrderByDescending(t => t.RecordedAt).Take(4))
                        {
                            <tr>
                                <td style="font-family: var(--font-mono); font-size: 0.78rem;">@tr.RecordedAt.ToString("dd MMM HH:mm")</td>
                                <td style="font-family: var(--font-mono); font-size: 0.78rem;">@tr.Latitude.ToString("F2")°, @tr.Longitude.ToString("F2")°</td>
                                <td style="font-family: var(--font-mono); font-weight: 700;">@tr.Altitude.ToString("N0")</td>
                                <td style="font-family: var(--font-mono); font-weight: 700;">@tr.Velocity.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div style="margin-top: 1rem;">
                <a asp-controller="TrajectoryRecords" asp-action="Index" class="ow-action">View Telemetry Archive →</a>
            </div>
        }
        else
        {
            <p style="color: #777; font-size: 0.95rem; margin-bottom: 1.5rem;">No coordinate vectors logged for this asset.</p>
            <a asp-controller="TrajectoryRecords" asp-action="Create" class="ow-action">+ Record Telemetry Vector</a>
        }
    </div>

    <div class="ow-panel">
        <div class="ow-eyebrow" style="color: var(--ow-red);">ANOMALY INCIDENTS (@Model.Satellite.Incidents.Count)</div>
        @if (Model.Satellite.Incidents.Any())
        {
            <div class="ow-table-wrap">
                <table class="ow-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Severity</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inc in Model.Satellite.Incidents.OrderByDescending(i => i.OccurredAt).Take(3))
                        {
                            var isCrit = inc.Severity.ToLowerInvariant() == "critical";
                            <tr>
                                <td><a asp-controller="Incidents" asp-action="Details" asp-route-id="@inc.Id"><strong>@inc.Type</strong></a></td>
                                <td><span class="ow-status @(isCrit ? "ow-status--critical" : "")">@inc.Severity</span></td>
                                <td style="font-family: var(--font-mono); font-size: 0.78rem;">@inc.OccurredAt.ToString("dd MMM yyyy")</td>
                                <td>@inc.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p style="color: #777; font-size: 0.95rem;">No flight anomalies on record for this satellite.</p>
        }
    </div>

    <div class="ow-panel">
        <div class="ow-eyebrow">GROUND OBSERVATIONS (@Model.Satellite.SatelliteObservations.Count)</div>
        @if (Model.Satellite.SatelliteObservations.Any())
        {
            <div class="ow-table-wrap">
                <table class="ow-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Station</th>
                            <th>Signal</th>
                            <th>Temp</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var obs in Model.Satellite.SatelliteObservations.OrderByDescending(o => o.ObservedAt).Take(3))
                        {
                            <tr>
                                <td><span class="ow-status">@obs.ObservationType</span></td>
                                <td>@obs.GroundStation</td>
                                <td style="font-family: var(--font-mono);">@(obs.SignalStrength.HasValue ? $"{obs.SignalStrength.Value:F1} dBm" : "—")</td>
                                <td style="font-family: var(--font-mono);">@(obs.Temperature.HasValue ? $"{obs.Temperature.Value:F1} °C" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p style="color: #777; font-size: 0.95rem;">No ground station observations recorded.</p>
        }
    </div>
</div>

<section class="ow-panel ow-celestrak-panel">

    <div class="ow-eyebrow">CURRENT ORBITAL DATA</div>

    @if (Model.CelesTrakError != null)
    {
        <p class="ow-empty-state">@Model.CelesTrakError</p>
    }
    else if (Model.CelesTrakData == null)
    {
        <p class="ow-empty-state">
            No current CelesTrak data available for this satellite.
        </p>
    }
    else
    {
        <div class="ow-celestrak-grid">

            <div class="ow-celestrak-item">
                <span>OBJECT NAME</span>
                <strong>@Model.CelesTrakData.ObjectName</strong>
            </div>

            <div class="ow-celestrak-item">
                <span>NORAD CATALOG ID</span>
                <strong>#@Model.CelesTrakData.NoradCatalogId</strong>
            </div>

            <div class="ow-celestrak-item">
                <span>EPOCH</span>
                <strong>
                    @Model.CelesTrakData.Epoch?.ToString("dd MMM yyyy HH:mm:ss") UTC
                </strong>
            </div>

            <div class="ow-celestrak-item">
                <span>MEAN MOTION</span>
                <strong>
                    @Model.CelesTrakData.MeanMotion?.ToString("F5") rev/day
                </strong>
            </div>

            <div class="ow-celestrak-item">
                <span>ECCENTRICITY</span>
                <strong>
                    @Model.CelesTrakData.Eccentricity?.ToString("F7")
                </strong>
            </div>

            <div class="ow-celestrak-item">
                <span>INCLINATION</span>
                <strong>
                    @Model.CelesTrakData.Inclination?.ToString("F4")°
                </strong>
            </div>

            <div class="ow-celestrak-item">
                <span>RA OF ASCENDING NODE</span>
                <strong>
                    @Model.CelesTrakData.RightAscensionOfAscendingNode?.ToString("F4")°
                </strong>
            </div>

            <div class="ow-celestrak-item">
                <span>ARGUMENT OF PERICENTER</span>
                <strong>
                    @Model.CelesTrakData.ArgumentOfPericenter?.ToString("F4")°
                </strong>
            </div>

            <div class="ow-celestrak-item">
                <span>MEAN ANOMALY</span>
                <strong>
                    @Model.CelesTrakData.MeanAnomaly?.ToString("F4")°
                </strong>
            </div>

            <div class="ow-celestrak-item">
                <span>BSTAR</span>
                <strong>
                    @Model.CelesTrakData.BStar?.ToString("E6")
                </strong>
            </div>

        </div>

        <div class="ow-celestrak-footer">
            ORBITAL ELEMENTS PROVIDED BY CELESTRAK GP DATA
        </div>
    }

</section>