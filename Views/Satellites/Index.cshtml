@model IEnumerable<OrbitWatch.Models.Satellite>

@{
    ViewData["Title"] = "Satellite Network";
}

<section class="ow-page-header">
    <div>
        <div class="ow-eyebrow">CONSTELLATION REGISTRY // TECHNICAL CATALOGUE</div>
        <h1 class="ow-page-title">Satellite Network</h1>
        <p class="ow-page-subtitle">Tracked orbital spacecraft, space telescopes, radar imaging constellations, and lunar relay modules.</p>
    </div>
    <div>
        <a asp-action="Create" class="ow-btn">+ Register Satellite</a>
    </div>
</section>

@if (Model.Any())
{
    <div class="ow-list">
        @{ int index = 1; }
        @foreach (var satellite in Model)
        {
            var statusClass = satellite.Status.ToLowerInvariant() switch
            {
                "active" => "ow-status--active",
                "inactive" => "",
                "decommissioned" => "ow-status--completed",
                _ => ""
            };

            <div class="ow-list-row">
                <div class="ow-list-index">@index.ToString("D2")</div>

                <div class="ow-list-body">
                    <div class="ow-list-title">
                        <a asp-action="Details" asp-route-id="@satellite.Id">@satellite.Name</a>
                    </div>
                    <div class="ow-list-meta">
                        NORAD ID: @satellite.NoradId &nbsp;•&nbsp;
                        ORBIT: @satellite.OrbitType &nbsp;•&nbsp;
                        SOVEREIGN: @satellite.Country
                    </div>
                </div>

                <div class="ow-list-aside">
                    <div class="ow-list-detail">
                        @(satellite.Mission != null ? satellite.Mission.Name : "Independent Asset")
                    </div>
                    <div class="ow-list-meta">
                        LAUNCH: @satellite.LaunchDate.ToString("dd MMM yyyy")
                    </div>
                </div>

                <div class="ow-list-status">
                    <span class="ow-status @statusClass">@satellite.Status</span>
                </div>

                <div class="ow-list-actions">
                    <a asp-action="Details" asp-route-id="@satellite.Id" class="ow-action">Details</a>
                    <a asp-action="Edit" asp-route-id="@satellite.Id" class="ow-action">Edit</a>
                    <a asp-action="Delete" asp-route-id="@satellite.Id" class="ow-action ow-action--danger">Delete</a>
                </div>
            </div>
            index++;
        }
    </div>
}
else
{
    <div class="ow-empty">
        <div class="ow-eyebrow" style="justify-content: center;">NO CELESTIAL ASSETS LOGGED</div>
        <h2 style="font-size: 2.2rem; margin: 1rem 0;">Satellite catalogue is currently clear.</h2>
        <p style="color: #666; margin-bottom: 2rem;">Register an active or planned satellite asset to begin ephemeris calculations.</p>
        <a asp-action="Create" class="ow-btn">+ Register First Satellite</a>
    </div>
}
