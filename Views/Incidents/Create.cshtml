@model OrbitWatch.Models.Incident

@{
    ViewData["Title"] = "Log Anomaly Incident";
}

<section class="ow-page-header">
    <div>
        <div class="ow-eyebrow" style="color: var(--ow-red);">ANOMALY SURVEILLANCE // DISPATCH ALERT</div>
        <h1 class="ow-page-title">Log Incident</h1>
        <p class="ow-page-subtitle">Submit real-time anomaly reports, collision proximity alerts, or systems diagnostics.</p>
    </div>
</section>

<div class="ow-form-wrap">
    <form asp-action="Create" method="post" novalidate>
        <div asp-validation-summary="All" class="text-danger mb-4"></div>

        <div class="ow-form-grid">
            <div class="ow-field ow-field--wide">
                <label asp-for="SatelliteId" class="ow-label">IMPACTED SATELLITE ASSET</label>
                <select asp-for="SatelliteId" asp-items="ViewBag.SatelliteId" class="ow-select">
                    <option value="">-- Select Target Satellite --</option>
                </select>
                <span asp-validation-for="SatelliteId" class="ow-field-error"></span>
            </div>

            <div class="ow-field ow-field--wide">
                <label asp-for="Type" class="ow-label">ANOMALY TYPE / DESIGNATION</label>
                <input asp-for="Type" class="ow-input" placeholder="e.g. Telemetry Loss, Orbital Decay, Solar Array Malfunction" />
                <span asp-validation-for="Type" class="ow-field-error"></span>
            </div>

            <div class="ow-field">
                <label asp-for="Severity" class="ow-label">SEVERITY CLASSIFICATION</label>
                <select asp-for="Severity" class="ow-select">
                    <option value="">-- Select Severity --</option>
                    <option>Low</option>
                    <option>Medium</option>
                    <option>High</option>
                    <option>Critical</option>
                </select>
                <span asp-validation-for="Severity" class="ow-field-error"></span>
            </div>

            <div class="ow-field">
                <label asp-for="Status" class="ow-label">RESOLUTION STATUS</label>
                <select asp-for="Status" class="ow-select">
                    <option value="">-- Select Status --</option>
                    <option>Open</option>
                    <option>Investigating</option>
                    <option>Resolved</option>
                    <option>Closed</option>
                </select>
                <span asp-validation-for="Status" class="ow-field-error"></span>
            </div>

            <div class="ow-field ow-field--wide">
                <label asp-for="OccurredAt" class="ow-label">TIMESTAMP OF OCCURRENCE (UTC)</label>
                <input asp-for="OccurredAt" class="ow-input" type="datetime-local" />
                <span asp-validation-for="OccurredAt" class="ow-field-error"></span>
            </div>

            <div class="ow-field ow-field--wide">
                <label asp-for="Description" class="ow-label">INCIDENT NARRATIVE &amp; TELEMETRY IMPACT</label>
                <textarea asp-for="Description" class="ow-textarea" placeholder="Detailed technical diagnostic, affected downlink frequencies, flight controller observations..."></textarea>
                <span asp-validation-for="Description" class="ow-field-error"></span>
            </div>
        </div>

        <div class="ow-form-actions">
            <button type="submit" class="ow-btn ow-btn--danger">File Incident Report →</button>
            <a asp-action="Index" class="ow-btn ow-btn--secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
