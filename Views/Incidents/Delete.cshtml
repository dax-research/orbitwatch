@model OrbitWatch.Models.Incident

@{
    ViewData["Title"] = $"Purge Incident #{Model.Id} — Flight Operations";
}

<section class="ow-page-header">
    <div>
        <div class="ow-eyebrow" style="color: var(--ow-red);">ANOMALY LOG // RECORD EXPUNGEMENT</div>
        <h1 class="ow-page-title">Delete Incident?</h1>
        <p class="ow-page-subtitle">Confirm permanent removal of Incident #@Model.Id from the operational registry.</p>
    </div>
</section>

<div class="ow-form-wrap">
    <div class="ow-warning-box">
        <strong>CAUTION: EXPUNGING ANOMALY DATA</strong><br />
        This action will permanently delete this incident record from the flight telemetry archive. This cannot be undone.
    </div>

    <dl class="ow-dl" style="margin-bottom: 2.5rem;">
        <dt>Anomaly Type</dt>
        <dd>@Model.Type</dd>
        <dt>Impacted Asset</dt>
        <dd>@(Model.Satellite?.Name ?? "Unassigned")</dd>
        <dt>Severity</dt>
        <dd>@Model.Severity</dd>
        <dt>Status</dt>
        <dd>@Model.Status</dd>
        <dt>Timestamp</dt>
        <dd>@Model.OccurredAt.ToString("dd MMMM yyyy HH:mm:ss") UTC</dd>
    </dl>

    <form asp-action="Delete" method="post" class="ow-form-actions">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="ow-btn ow-btn--danger">Execute Removal</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="ow-btn ow-btn--secondary">Abort &amp; Return</a>
    </form>
</div>
